{
  "name": "shardly",
  "version": "1.0.0",
  "description": "A hand-rolled document store with full-text search and BM25 ranking (mini Elasticsearch)",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "tsx src/api/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "crash-test": "tsx scripts/crash-test.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.1.0",
    "fastify": "^5.2.0",
    "unpdf": "^1.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
