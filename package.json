{
  "name": "shardly",
  "version": "1.0.0",
  "description": "TypeScript document store with durable WAL, BM25, HNSW and local hybrid RAG retrieval",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "tsx src/api/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "crash-test": "tsx scripts/crash-test.ts",
    "bench": "tsx scripts/bench.ts",
    "demo": "tsx scripts/seed-demo.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "compare:fts": "tsx scripts/compare-fts.ts",
    "evaluate:real": "tsx scripts/evaluate-real.ts",
    "evaluate:fetch": "tsx scripts/fetch-scifact.ts",
    "bench:concurrent": "tsx scripts/bench-concurrent.ts",
    "evaluate:workspace": "tsx scripts/evaluate-workspace.ts",
    "bench:maintenance": "tsx scripts/bench-maintenance.ts",
    "profile:engine": "node --expose-gc --import tsx scripts/profile-engine.ts",
    "mcp": "tsx src/mcp.ts",
    "bench:ann": "tsx scripts/bench-ann.ts",
    "evaluate:hybrid": "tsx scripts/evaluate-hybrid.ts",
    "crash-test:hybrid": "vitest run tests/hybrid-recovery.test.ts",
    "example:rag": "tsx examples/local-rag.ts",
    "start:built": "node dist/src/api/server.js",
    "models:check": "tsx scripts/check-local-models.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fastify": "^5.2.0",
    "fflate": "^0.8.3",
    "htmlparser2": "^10.1.0",
    "mailparser": "^3.9.46",
    "rtf-parser": "^1.3.3",
    "unpdf": "^1.7.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts"
}
