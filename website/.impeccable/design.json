      "css": ".ds-rail{position:relative;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:4px;width:28px;height:24px;text-decoration:none}.ds-rail>span:not(.ds-preview){display:block;width:8px;height:1px;background:var(--hair-solid)}.ds-rail>span:nth-child(2){width:22px;background:var(--accent)}.ds-rail>span:nth-child(3){width:9px}.ds-preview{position:absolute;left:36px;top:50%;transform:translate(4px,-50%);width:310px;max-width:calc(100vw - 80px);visibility:hidden;opacity:0;pointer-events:none;background:var(--ink-1);border:1px solid var(--hair-2);border-radius:14px;padding:13px 15px;box-shadow:0 12px 28px #00000014;transition:opacity 160ms var(--ease-out),transform 160ms var(--ease-out),visibility 160ms}.ds-preview strong{display:block;font:600 13px/1.5 var(--f-sans);color:var(--fg);margin-bottom:5px}.ds-preview>span{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow:hidden;color:var(--fg-2);font:400 12px/1.55 var(--f-sans)}.ds-rail:hover .ds-preview,.ds-rail:focus-visible .ds-preview{visibility:visible;opacity:1;pointer-events:auto;transform:translate(0,-50%)}.ds-rail:focus-visible .ds-preview{transition:none}.ds-rail:focus-visible{outline:2px solid var(--accent);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-preview{transition:none}}"
