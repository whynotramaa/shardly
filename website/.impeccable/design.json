  "narrative": {
    "northStar": "The engineering reader",
    "overview": "This system belongs to website/, the separate Shardly engineering guide. It records the approved Coconat reader as implemented in app/globals.css and the guide components. The repository-root DESIGN.md governs web/ and remains separate.\n\nPlain paper and charcoal grounds hold long-form text, compact diagrams, and runnable examples. Blue in light mode and peach in dark mode identify links and changing diagram state. Source links, captions, and measurements support the reading rather than competing with it.",
    "keyCharacteristics": [
      "Local Coconat headings with Syne reading text and Geist Mono code/data.",
      "A centered reading column with an independent tick navigation rail.",
      "Flat reading grounds, fine rules, and compact geometric SVG drawings.",
      "Explicit finite playback, manual steps, and static reduced-motion exploration."
    ],
    "rules": [
      {
        "name": "The surface derivation Rule",
        "body": "A component that redefines foreground or accent must recompute derived tokens on that component, as the existing contrasting plate does.",
        "section": "colors"
      },
      {
        "name": "The centered reading Rule",
        "body": "Center the hero and article at the same maximum width. Keep the chapter rail independent.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do center hero copy and the article together while keeping text left-aligned.",
      "Do use the theme-aware color tokens and recompute derived colors on a contrasting plate.",
      "Do preserve keyboard focus, skip navigation, preview dismissal, and horizontally scrollable tables.",
      "Do keep scene playback optional, finite, pausable, and inactive offscreen."
    ],
    "donts": [
      "Don't replace local Coconat with an approximate display face.",
      "Don't turn the narrow tick rail into thumbnail cards.",
      "Don't restore the inherited offset header shadows or oversized display utilities in this reader.",
      "Don't use animated emphasis that obscures the active evidence span."
    ]
  }
}
